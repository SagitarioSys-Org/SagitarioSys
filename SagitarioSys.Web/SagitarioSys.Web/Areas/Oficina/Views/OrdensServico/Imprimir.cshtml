@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <title>Imprimir Ordem de Serviço</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

    <link rel="stylesheet" href="~/css/imprimir.css" asp-append-version="true" />
</head>
<body>

    <input type="hidden" id="hdfOsId" value="@ViewBag.OsId" />

    <div class="text-center mt-4 mb-3 no-print">
        <button class="btn btn-primary font-weight-bold px-4 shadow" onclick="window.print()"><i class="fas fa-print mr-2"></i> Imprimir / Salvar PDF</button>
        <button class="btn btn-light border px-4 shadow-sm ml-2" onclick="window.close()">Fechar</button>
    </div>

    <div class="a4-container" id="conteudoFolha">
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <h5 class="mt-3 text-muted">Gerando Documento...</h5>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/js/Oficina/imprimir.js" asp-append-version="true"></script>
    <script src="~/js/config.js" asp-append-version="true"></script>
</body>
</html>