@{
    ViewData["Title"] = "Gestão de Veículos";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
<link rel="stylesheet" href="~/css/Oficina/veiculos.css" />


<div class="d-flex justify-content-between align-items-center mb-4 mt-2">
    <div>
        <h2 class="m-0 font-weight-bold" style="color: var(--zinc-900); font-size: 1.75rem; letter-spacing: -0.5px;">Veículos</h2>
        <p class="text-muted m-0" style="font-size: 0.95rem;">Controle da frota e histórico dos clientes.</p>
    </div>
    <button class="btn font-weight-bold px-3 py-2 shadow-sm d-flex align-items-center" style="background-color: var(--zinc-900); color: white; border-radius: 8px;" onclick="abrirModal()">
        <i class="fas fa-plus mr-2"></i> Novo Veículo
    </button>
</div>

<div class="glass-card p-0 overflow-hidden mb-4">
    <div class="p-3 border-bottom d-flex align-items-center bg-white">
        <i class="fas fa-search text-muted mr-3 pl-2"></i>
        <input type="text" id="txtBusca" class="form-control border-0 shadow-none p-0" placeholder="Buscar por placa, modelo ou cliente..." style="font-size: 0.95rem; background: transparent;">
    </div>

    <div class="table-responsive">
        <table class="table table-borderless table-hover align-middle m-0" id="tbVeiculos">
            <thead style="border-bottom: 2px solid var(--zinc-100);">
                <tr style="color: var(--zinc-400); font-size: 0.75rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px;">
                    <th class="pl-4 py-3">Placa</th>
                    <th class="py-3">Veículo</th>
                    <th class="py-3">Ano / Cor</th>
                    <th class="py-3">Cliente (Dono)</th>
                    <th class="py-3 text-center" width="100">Ações</th>
                </tr>
            </thead>
            <tbody style="color: var(--zinc-800); font-size: 0.9rem;">
                <tr><td colspan="5" class="text-center py-5"><i class="fas fa-spinner fa-spin mr-2"></i> Carregando veículos...</td></tr>
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modalVeiculo" tabindex="-1" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
            <div class="modal-header d-flex justify-content-between align-items-center" style="background-color: var(--zinc-900); color: var(--zinc-50);">
                <h5 class="modal-title font-weight-bold" id="modalTitle"><i class="fas fa-car mr-2 text-emerald-500"></i> Ficha do Veículo</h5>
                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
            </div>

            <form id="formVeiculo">
                <div class="modal-body bg-white p-4">
                    <input type="hidden" id="txtId" />

                    <div class="row">
                        <div class="col-md-12 form-group">
                            <label class="font-weight-bold text-muted" style="font-size: 0.85rem;">
                                Proprietário (Cliente) <span class="text-danger">*</span>
                            </label>

                            <!-- Campo de busca visível -->
                            <div class="input-group">
                                <input type="text" id="txtBuscaCliente" class="form-control"
                                       style="border-radius: 6px 0 0 6px; border-color: var(--zinc-300);"
                                       placeholder="Digite o nome, CPF ou telefone..." autocomplete="off">
                                <div class="input-group-append">
                                    <button type="button" class="btn btn-outline-secondary"
                                            style="border-radius: 0;" onclick="limparClienteSelecionado()"
                                            title="Limpar">
                                        <i class="fas fa-times"></i>
                                    </button>
                                    <button type="button" class="btn text-white font-weight-bold"
                                            style="background-color: var(--emerald-500); border-radius: 0 6px 6px 0;"
                                            onclick="abrirModalNovoClienteVeiculo()" title="Cadastrar novo cliente">
                                        <i class="fas fa-user-plus mr-1"></i> Novo
                                    </button>
                                </div>
                            </div>

                            <!-- Dropdown de resultados -->
                            <div id="dropdownClientes" class="list-group shadow-sm"
                                 style="display:none; position:absolute; z-index:9999; width:calc(100% - 30px); max-height:220px; overflow-y:auto; border-radius:0 0 8px 8px;">
                            </div>

                            <!-- Campo oculto que guarda o ID real do cliente selecionado -->
                            <input type="hidden" id="hdnClienteId" required>

                            <!-- Badge do cliente selecionado -->
                            <div id="clienteSelecionadoBadge" class="mt-2" style="display:none;">
                                <span class="badge px-3 py-2"
                                      style="background:#f0fdf4; color:#16a34a; border:1px solid #bbf7d0; border-radius:20px; font-size:0.88rem;">
                                    <i class="fas fa-user-check mr-1"></i>
                                    <span id="clienteSelecionadoNome"></span>
                                </span>
                            </div>
                        </div>
                    </div>


                    <div class="row">
                        <div class="col-md-3 form-group">
                            <label class="font-weight-bold text-muted" style="font-size: 0.85rem;">Placa <span class="text-danger">*</span></label>
                            <input type="text" class="form-control plate-input" id="txtPlaca" required placeholder="ABC1C34" maxlength="8">
                        </div>
                        <div class="col-md-4 form-group">
                            <label class="font-weight-bold text-muted" style="font-size: 0.85rem;">Marca <span class="text-danger">*</span></label>
                            <select class="form-control" style="border-radius: 6px;" id="ddlMarca" required>
                                <option value="">Selecione a Marca</option>
                            </select>
                        </div>
                        <div class="col-md-5 form-group">
                            <label class="font-weight-bold text-muted" style="font-size: 0.85rem;">Modelo <span class="text-danger">*</span></label>
                            <select class="form-control" style="border-radius: 6px;" id="ddlModelo" required disabled>
                                <option value="">Selecione a marca primeiro</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-3 form-group">
                            <label class="font-weight-bold text-muted" style="font-size: 0.85rem;">Ano / Modelo <span class="text-danger">*</span></label>
                            <select class="form-control" style="border-radius: 6px;" id="ddlAno" required disabled>
                                <option value="">Aguardando...</option>
                            </select>
                        </div>
                        <div class="col-md-3 form-group">
                            <label class="font-weight-bold text-muted" style="font-size: 0.85rem;">Cor</label>
                            <input type="text" class="form-control" style="border-radius: 6px;" id="txtCor" placeholder="Ex: Prata">
                        </div>
                        <div class="col-md-3 form-group">
                            <label class="font-weight-bold text-muted" style="font-size: 0.85rem;">KM Atual</label>
                            <input type="number" class="form-control font-weight-bold text-primary" style="border-radius: 6px;" id="txtKm" placeholder="0" min="0">
                        </div>
                        <div class="col-md-3 form-group">
                            <label class="font-weight-bold text-muted" style="font-size: 0.85rem;">Observações</label>
                            <input type="text" class="form-control" style="border-radius: 6px;" id="txtObs" placeholder="Ex: Arranhão na porta">
                        </div>
                    </div>

                </div>
                <div class="modal-footer" style="background-color: var(--zinc-50); border-top: 1px solid var(--zinc-200);">
                    <button type="button" class="btn btn-outline-secondary font-weight-bold" data-dismiss="modal" style="border-radius: 6px;">Cancelar</button>
                    <button type="submit" class="btn text-white font-weight-bold px-4" id="btnSalvar" style="background-color: var(--emerald-500); border-radius: 6px;">
                        Salvar Veículo
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Rápido de Cadastro de Cliente (acionado dentro do modal de veículo) -->
<div class="modal fade" id="modalClienteRapido" tabindex="-1" aria-hidden="true" data-backdrop="static" style="z-index: 1060;">
    <div class="modal-dialog modal-xl">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">

            <div class="modal-header d-flex justify-content-between align-items-center" style="background-color: var(--zinc-900); color: var(--zinc-50);">
                <h5 class="modal-title font-weight-bold">
                    <i class="fas fa-user-plus mr-2 text-emerald-500"></i> Cadastrar Novo Cliente
                </h5>
                <button type="button" class="close text-white" onclick="fecharModalClienteRapido()">&times;</button>
            </div>

            <form id="formClienteRapido">
                <div class="modal-body" style="background-color: var(--zinc-50); padding: 1.5rem;">
                    <input type="hidden" id="txtIdCR" />

                    <div class="glass-card p-3 mb-4 shadow-sm" style="border-radius: 8px;">
                        <h6 class="font-weight-bold text-uppercase mb-3" style="color: var(--zinc-500); font-size: 0.8rem; letter-spacing: 1px;">Dados Principais</h6>
                        <div class="row">
                            <div class="col-md-8 form-group mb-0">
                                <label class="font-weight-bold" style="color: var(--zinc-700); font-size: 0.85rem;">Nome Completo / Razão Social <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" style="border-radius: 6px;" id="txtNomeCR" required placeholder="Ex: João da Silva">
                            </div>
                            <div class="col-md-4 form-group mb-0">
                                <label class="font-weight-bold" style="color: var(--zinc-700); font-size: 0.85rem;">CPF / CNPJ</label>
                                <input type="text" class="form-control font-weight-bold text-primary" style="border-radius: 6px;" id="txtCpfCnpjCR" placeholder="000.000.000-00">
                            </div>
                        </div>
                    </div>

                    <div class="glass-card p-3 mb-4 shadow-sm" style="border-radius: 8px;">
                        <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                            <h6 class="font-weight-bold text-uppercase m-0" style="color: var(--zinc-500); font-size: 0.8rem; letter-spacing: 1px;">Meios de Contato</h6>
                            <button type="button" class="btn btn-sm text-white font-weight-bold shadow-sm" style="background-color: var(--emerald-500); border-radius: 6px;" onclick="adicionarLinhaContatoCR()">
                                <i class="fas fa-plus mr-1"></i> Adicionar Mais
                            </button>
                        </div>
                        <div class="row font-weight-bold pb-2 mb-2 text-muted" style="font-size: 0.8rem;">
                            <div class="col-md-3">Telefone/Celular</div>
                            <div class="col-md-4">E-mail</div>
                            <div class="col-md-4">Observação</div>
                        </div>
                        <div id="boxContatosCR"></div>
                    </div>

                    <div class="glass-card p-3 shadow-sm" style="border-radius: 8px;">
                        <h6 class="font-weight-bold text-uppercase mb-3" style="color: var(--zinc-500); font-size: 0.8rem; letter-spacing: 1px;">Endereço</h6>
                        <div class="row">
                            <div class="col-md-3 form-group">
                                <label class="font-weight-bold" style="color: var(--zinc-700); font-size: 0.85rem;">CEP</label>
                                <div class="input-group">
                                    <input type="text" class="form-control" style="border-radius: 6px 0 0 6px;" id="txtCepCR" placeholder="00000-000">
                                    <div class="input-group-append">
                                        <button class="btn btn-secondary" type="button" style="border-radius: 0 6px 6px 0;" onclick="buscarCepCR()"><i class="fas fa-search"></i></button>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-7 form-group">
                                <label class="font-weight-bold" style="color: var(--zinc-700); font-size: 0.85rem;">Logradouro</label>
                                <input type="text" class="form-control" style="border-radius: 6px;" id="txtLogradouroCR">
                            </div>
                            <div class="col-md-2 form-group">
                                <label class="font-weight-bold" style="color: var(--zinc-700); font-size: 0.85rem;">Número</label>
                                <input type="text" class="form-control" style="border-radius: 6px;" id="txtNumeroCR">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-5 form-group mb-0">
                                <label class="font-weight-bold" style="color: var(--zinc-700); font-size: 0.85rem;">Bairro</label>
                                <input type="text" class="form-control" style="border-radius: 6px;" id="txtBairroCR">
                            </div>
                            <div class="col-md-5 form-group mb-0">
                                <label class="font-weight-bold" style="color: var(--zinc-700); font-size: 0.85rem;">Cidade</label>
                                <input type="text" class="form-control" style="border-radius: 6px;" id="txtCidadeCR">
                            </div>
                            <div class="col-md-2 form-group mb-0">
                                <label class="font-weight-bold" style="color: var(--zinc-700); font-size: 0.85rem;">UF</label>
                                <input type="text" class="form-control" style="border-radius: 6px; text-transform: uppercase;" id="txtUfCR" maxlength="2">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer" style="background-color: var(--zinc-100); border-top: 1px solid var(--zinc-200);">
                    <button type="button" class="btn btn-outline-secondary font-weight-bold" onclick="fecharModalClienteRapido()" style="border-radius: 6px;">Cancelar</button>
                    <button type="submit" class="btn text-white font-weight-bold px-4" id="btnSalvarCR" style="background-color: var(--emerald-500); border-radius: 6px;">
                        <i class="fas fa-save mr-1"></i> Salvar e Selecionar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/Oficina/veiculos.js"></script>
}