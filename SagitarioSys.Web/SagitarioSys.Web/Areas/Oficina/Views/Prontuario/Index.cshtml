<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

<div class="d-flex justify-content-between align-items-center mb-4 mt-2">
    <div>
        <h2 class="m-0 font-weight-bold" style="color: var(--zinc-900); font-size: 1.75rem; letter-spacing: -0.5px;">
            Ficha do Veículo
        </h2>
        <p class="text-muted m-0" style="font-size: 0.95rem;">Consulte o histórico completo de serviços por placa.</p>
    </div>
</div>


<div class="glass-card p-3 mb-4">
    <div class="d-flex align-items-center">
        <i class="fas fa-search text-muted mr-3 pl-2"></i>
        <input type="text" id="txtBuscaPlaca" class="form-control border-0 shadow-none p-0"
               placeholder="Digite a placa do veículo e pressione Enter (ex: ABC1C34)..."
               style="font-size: 1rem; background: transparent; text-transform: uppercase;"
               maxlength="8">
        <button class="btn font-weight-bold px-4" id="btnBuscar"
                style="background-color: var(--zinc-900); color: white; border-radius: 8px; min-width: 120px;"
                onclick="buscarProntuario()">
            <i class="fas fa-search mr-2"></i> Buscar
        </button>
    </div>
</div>


<div id="boxResultado"></div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/Oficina/prontuario.js" asp-append-version="true"></script>
}
