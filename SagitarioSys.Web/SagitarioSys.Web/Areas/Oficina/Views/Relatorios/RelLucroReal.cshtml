
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

<div class="d-flex justify-content-between align-items-center mb-4 mt-2">
    <div>
        <h2 class="m-0 font-weight-bold" style="color: var(--zinc-900); font-size: 1.75rem; letter-spacing: -0.5px;">
            <i class="fas fa-hand-holding-usd mr-2"></i> Lucro Real
        </h2>
        <p class="text-muted m-0" style="font-size: 0.95rem;">Faturamento - Custo das Peças - Despesas = Lucro Líquido.</p>
    </div>
    <a href="/Oficina/Relatorios/ImprimirLucroReal" id="btnImprimir" target="_blank"
       class="btn font-weight-bold px-3 py-2 shadow-sm"
       style="background-color: var(--zinc-900); color: white; border-radius: 8px;">
        <i class="fas fa-print mr-2"></i> Imprimir
    </a>
</div>

@* {{!-- Filtro --}} *@
<div class="glass-card p-3 mb-4">
    <div class="row align-items-end">
        <div class="col-md-3 form-group mb-0">
            <label class="font-weight-bold text-muted" style="font-size:0.85rem;">Data Inicial</label>
            <input type="date" class="form-control" id="dtInicio" style="border-radius:6px;">
        </div>
        <div class="col-md-3 form-group mb-0">
            <label class="font-weight-bold text-muted" style="font-size:0.85rem;">Data Final</label>
            <input type="date" class="form-control" id="dtFim" style="border-radius:6px;">
        </div>
        <div class="col-md-2">
            <button class="btn font-weight-bold px-4 w-100" id="btnFiltrar"
                    style="background-color: var(--zinc-900); color:white; border-radius:6px;"
                    onclick="carregarLucro()">
                <i class="fas fa-search mr-2"></i> Calcular
            </button>
        </div>
    </div>
</div>

@* {{!-- KPIs principais --}} *@
<div class="row mb-4" id="boxKpis">
    <div class="col-md-3">
        <div class="glass-card p-3 text-center shadow-sm">
            <div class="text-muted" style="font-size:0.8rem; text-transform:uppercase; letter-spacing:1px;">Faturamento Bruto</div>
            <div class="font-weight-bold text-primary mt-1" style="font-size:1.4rem;" id="kpiFaturamento">-</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="glass-card p-3 text-center shadow-sm">
            <div class="text-muted" style="font-size:0.8rem; text-transform:uppercase; letter-spacing:1px;">(-) Custo das Peças</div>
            <div class="font-weight-bold text-danger mt-1" style="font-size:1.4rem;" id="kpiCustoPecas">-</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="glass-card p-3 text-center shadow-sm">
            <div class="text-muted" style="font-size:0.8rem; text-transform:uppercase; letter-spacing:1px;">(-) Despesas</div>
            <div class="font-weight-bold text-danger mt-1" style="font-size:1.4rem;" id="kpiDespesas">-</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="glass-card p-4 text-center shadow-sm" id="cardLucro" style="border: 2px solid #10b981;">
            <div class="text-muted" style="font-size:0.8rem; text-transform:uppercase; letter-spacing:1px;">= Lucro Real</div>
            <div class="font-weight-bold mt-1" style="font-size:1.6rem;" id="kpiLucro">-</div>
            <div class="text-muted" style="font-size:0.8rem;" id="kpiMargem"></div>
        </div>
    </div>
</div>

@* {{!-- Gráfico --}} *@
<div class="glass-card p-4 mb-4 shadow-sm">
    <h6 class="font-weight-bold text-uppercase mb-3" style="color:var(--zinc-500); font-size:0.8rem; letter-spacing:1px;">
        Faturamento Diário no Período
    </h6>
    <div style="max-height: 220px;">
        <canvas id="graficoLucro"></canvas>
    </div>
</div>

@* {{!-- Despesas detalhadas --}} *@
<div class="glass-card p-0 overflow-hidden">
    <div class="p-3 border-bottom bg-white">
        <h6 class="font-weight-bold m-0 text-uppercase" style="color:var(--zinc-500); font-size:0.8rem; letter-spacing:1px;">
            <i class="fas fa-minus-circle mr-2 text-danger"></i> Despesas no Período
        </h6>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle m-0" id="tbDespesas">
            <thead style="background-color: var(--zinc-100); color: var(--zinc-600); font-size: 0.82rem; text-transform: uppercase;">
                <tr>
                    <th class="pl-4">Data</th>
                    <th>Categoria</th>
                    <th>Descrição</th>
                    <th>Forma Pgto.</th>
                    <th class="text-right pr-4">Valor</th>
                </tr>
            </thead>
            <tbody style="font-size:0.9rem;">
                <tr><td colspan="5" class="text-center py-4 text-muted">Selecione o período e clique em Calcular.</td></tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="~/js/Oficina/rel-lucroreal.js" asp-append-version="true"></script>
}
