
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

<div class="d-flex justify-content-between align-items-center mb-4 mt-2">
    <div>
        <h2 class="m-0 font-weight-bold" style="color: var(--zinc-900); font-size: 1.75rem; letter-spacing: -0.5px;">
            <i class="fas fa-calendar-alt mr-2"></i> Vendas por Período
        </h2>
        <p class="text-muted m-0" style="font-size: 0.95rem;">Faturamento de OS por período selecionado.</p>
    </div>
    <a href="/Oficina/Relatorios/ImprimirVendas" id="btnImprimir" target="_blank"
       class="btn font-weight-bold px-3 py-2 shadow-sm"
       style="background-color: var(--zinc-900); color: white; border-radius: 8px;">
        <i class="fas fa-print mr-2"></i> Imprimir
    </a>
</div>

@* {{!-- Filtro de período --}} *@
<div class="glass-card p-3 mb-4">
    <div class="row align-items-end">
        <div class="col-md-3 form-group mb-0">
            <label class="font-weight-bold text-muted" style="font-size:0.85rem;">Data Inicial</label>
            <input type="date" class="form-control" id="dtInicio" style="border-radius:6px;">
        </div>
        <div class="col-md-3 form-group mb-0">
            <label class="font-weight-bold text-muted" style="font-size:0.85rem;">Data Final</label>
            <input type="date" class="form-control" id="dtFim" style="border-radius:6px;">
        </div>
        <div class="col-md-2">
            <button class="btn font-weight-bold px-4 w-100" id="btnFiltrar"
                    style="background-color: var(--zinc-900); color:white; border-radius:6px;"
                    onclick="carregarVendas()">
                <i class="fas fa-search mr-2"></i> Filtrar
            </button>
        </div>
        <div class="col-md-4 text-right">
            <small class="text-muted">Mostrando apenas OS com status <strong>Faturada</strong></small>
        </div>
    </div>
</div>

@* {{!-- KPIs --}} *@
<div class="row mb-4" id="boxKpis">
    <div class="col-md-3">
        <div class="glass-card p-3 text-center shadow-sm">
            <div class="text-muted" style="font-size:0.8rem; text-transform:uppercase; letter-spacing:1px;">OS Faturadas</div>
            <div class="font-weight-bold mt-1" style="font-size:2rem;" id="kpiTotal">-</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="glass-card p-3 text-center shadow-sm">
            <div class="text-muted" style="font-size:0.8rem; text-transform:uppercase; letter-spacing:1px;">Faturamento Total</div>
            <div class="font-weight-bold text-success mt-1" style="font-size:1.5rem;" id="kpiFaturamento">-</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="glass-card p-3 text-center shadow-sm">
            <div class="text-muted" style="font-size:0.8rem; text-transform:uppercase; letter-spacing:1px;">Ticket Médio</div>
            <div class="font-weight-bold text-primary mt-1" style="font-size:1.5rem;" id="kpiTicket">-</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="glass-card p-3 text-center shadow-sm">
            <div class="text-muted" style="font-size:0.8rem; text-transform:uppercase; letter-spacing:1px;">Maior Venda</div>
            <div class="font-weight-bold text-warning mt-1" style="font-size:1.5rem;" id="kpiMaior">-</div>
        </div>
    </div>
</div>

@* {{!-- Gráfico --}} *@
<div class="glass-card p-4 mb-4 shadow-sm">
    <h6 class="font-weight-bold text-uppercase mb-3" style="color:var(--zinc-500); font-size:0.8rem; letter-spacing:1px;">
        Faturamento por Dia
    </h6>
    <div style="max-height: 220px;">
        <canvas id="graficoVendas"></canvas>
    </div>
</div>

@* {{!-- Tabela --}} *@
<div class="glass-card p-0 overflow-hidden">
    <div class="p-3 border-bottom bg-white">
        <h6 class="font-weight-bold m-0 text-uppercase" style="color:var(--zinc-500); font-size:0.8rem; letter-spacing:1px;">
            <i class="fas fa-list mr-2"></i> Detalhamento das OS
        </h6>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle m-0" id="tbVendas">
            <thead style="background-color: var(--zinc-100); color: var(--zinc-600); font-size: 0.82rem; text-transform: uppercase;">
                <tr>
                    <th class="pl-4">Nº OS</th>
                    <th>Data Pgto.</th>
                    <th>Cliente</th>
                    <th>Veículo</th>
                    <th>Forma Pgto.</th>
                    <th class="text-right pr-4">Valor</th>
                </tr>
            </thead>
            <tbody style="font-size:0.9rem;">
                <tr><td colspan="6" class="text-center py-4 text-muted">Selecione o período e clique em Filtrar.</td></tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="~/js/Oficina/rel-vendas.js" asp-append-version="true"></script>
}
