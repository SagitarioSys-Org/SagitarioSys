@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <title>Peças Mais Vendidas</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <style>
        body {
            background: #f1f1f1;
            font-family: 'Segoe UI', sans-serif;
        }

        .a4-container {
            width: 210mm;
            margin: 0 auto 30px auto;
            background: white;
            padding: 15mm;
            box-shadow: 0 4px 20px rgba(0,0,0,0.15);
        }

        .section-title {
            background: #1a1a1a;
            color: white;
            padding: 5px 10px;
            font-size: 0.8rem;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 1px;
            border-radius: 3px;
            margin-bottom: 10px;
        }
    </style>
</head>
<body>
    <div class="text-center mt-4 mb-3" id="divBotoes">
        <button class="btn btn-primary font-weight-bold px-4 shadow" onclick="imprimir()">
            <i class="fas fa-print mr-2"></i> Imprimir / Salvar PDF
        </button>
        <button class="btn btn-light border px-4 shadow-sm ml-2" onclick="window.close()">Fechar</button>
    </div>
    <div class="a4-container" id="conteudoFolha">
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <h5 class="mt-3 text-muted">Gerando Relatório...</h5>
        </div>
    </div>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/js/config.js" asp-append-version="true"></script>
    <script src="~/js/Oficina/rel-pecas-imprimir.js" asp-append-version="true"></script>
</body>
</html>
