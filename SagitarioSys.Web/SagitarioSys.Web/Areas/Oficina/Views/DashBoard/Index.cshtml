<div class="mb-4 mt-2">
    <h2 class="m-0 font-weight-bold" style="color: var(--zinc-900); font-size: 1.75rem; letter-spacing: -0.5px;">Dashboard</h2>
    <p class="text-muted m-0" style="font-size: 0.95rem;">Visão geral da sua oficina este mês.</p>
</div>

<div class="card card-outline card-primary shadow-sm mb-4">
    <div class="card-body">
        <h2 class="font-weight-bold text-dark">Olá, <span id="lblNomeGestor" class="text-primary">Gestor</span>! 👋</h2>
        <p class="text-muted lead">Bem-vindo ao seu painel de controle. Aqui está o resumo do seu dia.</p>
        <hr />
        <div class="d-flex justify-content-between align-items-center flex-wrap">
            <h5 class="mb-0 text-secondary"><i class="far fa-calendar-alt text-info mr-2"></i> <span id="lblDataAtual">--/--/----</span></h5>
            <h3 class="mb-0 font-weight-bold text-dark"><i class="far fa-clock text-info mr-2"></i> <span id="lblHoraAtual">--:--:--</span></h3>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="glass-card p-4">
            <div class="d-flex align-items-center mb-2">
                <i class="fas fa-chart-line text-success mr-2"></i>
                <span class="text-muted font-weight-bold" style="font-size: 0.8rem;">Lucro Líquido</span>
            </div>
            <h3 class="m-0 font-weight-bold" style="color: var(--zinc-800);" id="dashLucro">R$ 0,00</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="glass-card p-4">
            <div class="d-flex align-items-center mb-2">
                <i class="fas fa-exclamation-triangle text-warning mr-2"></i>
                <span class="text-muted font-weight-bold" style="font-size: 0.8rem;">Alertas de Estoque</span>
            </div>
            <h3 class="m-0 font-weight-bold text-warning" id="dashAlertasEstoque">0</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="glass-card p-4">
            <div class="d-flex align-items-center mb-2">
                <i class="fas fa-clipboard-list text-primary mr-2"></i>
                <span class="text-muted font-weight-bold" style="font-size: 0.8rem;">O.S. Pendentes</span>
            </div>
            <h3 class="m-0 font-weight-bold" style="color: var(--zinc-800);" id="dashOsPendentes">0</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="glass-card p-4">
            <div class="d-flex align-items-center mb-2">
                <i class="fas fa-boxes text-secondary mr-2"></i>
                <span class="text-muted font-weight-bold" style="font-size: 0.8rem;">Total Peças</span>
            </div>
            <h3 class="m-0 font-weight-bold" style="color: var(--zinc-800);" id="dashTotalPecas">0</h3>
        </div>
    </div>
</div>

<div class="row mb-5">
    <div class="col-md-8">
        <div class="glass-card p-4 h-100">
            <h6 class="font-weight-bold mb-4" style="color: var(--zinc-800);">Desempenho Financeiro (Mês Atual)</h6>
            <div style="height: 250px;">
                <canvas id="graficoFinanceiro"></canvas>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="glass-card p-4 h-100">
            <h6 class="font-weight-bold mb-4"><i class="fas fa-exclamation-triangle text-warning mr-2"></i> Estoque Baixo</h6>

            <div id="listaEstoqueBaixo" style="max-height: 250px; overflow-y: auto; padding-right: 5px;">
                <div class="text-center text-muted mt-4">
                    <i class="fas fa-spinner fa-spin mb-2"></i><br>Analisando estoque...
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">


        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white border-bottom-0 pt-3 pb-0">
                <h3 class="card-title font-weight-bold text-dark">
                    <i class="far fa-newspaper text-primary mr-2"></i> Radar de Atualizações
                </h3>
            </div>
            <div class="card-body pt-3">
                <div class="row">
                    <div class="col-md-6 border-right">
                        <h5 class="text-info font-weight-bold mb-3" style="font-size: 1.1rem;">
                            <i class="fas fa-map-marker-alt mr-1"></i> Notícias: <span id="lblCidadeNoticias">Buscando...</span>
                        </h5>
                        <div id="boxNoticiasLocais">
                            <div class="text-center py-2"><i class="fas fa-spinner fa-spin text-muted"></i></div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <h5 class="text-success font-weight-bold mb-3" style="font-size: 1.1rem;">
                            <i class="fas fa-futbol mr-1"></i> Esportes
                        </h5>
                        <div id="boxNoticiasEsportes">
                            <div class="text-center py-2"><i class="fas fa-spinner fa-spin text-muted"></i></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card card-outline card-warning shadow-sm mb-4">
            <div class="card-header border-0 pb-0">
                <h3 class="card-title font-weight-bold text-dark"><i class="fas fa-cloud-sun text-warning mr-2"></i> Clima Local</h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-tool" onclick="carregarClimaEInfoLocal()" title="Atualizar Clima">
                        <i class="fas fa-sync-alt"></i>
                    </button>
                </div>
            </div>
            <div class="card-body text-center pt-2">
                <div id="weatherLoading" class="py-4">
                    <i class="fas fa-spinner fa-spin fa-2x text-muted mb-2"></i>
                    <p class="text-muted mb-0">Buscando sua localização...</p>
                </div>

                <div id="weatherContent" style="display: none;">
                    <i id="iconeClima" class="fas fa-sun fa-4x text-warning mb-3 mt-2"></i>
                    <h1 class="display-4 font-weight-bold text-dark mb-0"><span id="lblTemp">--</span>°C</h1>
                    <h5 class="text-muted text-uppercase mt-2 font-weight-bold" id="lblCondicao">--</h5>
                    <div class="d-flex justify-content-center mt-4 pt-2 border-top">
                        <div class="mx-3">
                            <i class="fas fa-wind text-info mb-1"></i>
                            <p class="mb-0 font-weight-bold" id="lblVento">-- km/h</p>
                            <small class="text-muted">Vento</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="info-box shadow-sm bg-white">
            <span class="info-box-icon bg-success"><i class="fas fa-server"></i></span>
            <div class="info-box-content">
                <span class="info-box-text text-uppercase font-weight-bold text-muted">Status do Sistema</span>
                <span class="info-box-number text-success" style="font-size: 1.2rem;">100% Operacional</span>
                <div class="progress mt-2" style="height: 4px;">
                    <div class="progress-bar bg-success" style="width: 100%"></div>
                </div>
                <span class="progress-description text-muted mt-2" style="font-size: 0.85rem;">
                    Conexão estável e segura.
                </span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/Oficina/dashboard.js"></script>
}