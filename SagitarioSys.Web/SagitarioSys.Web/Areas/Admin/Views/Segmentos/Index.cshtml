@{
    ViewData["Title"] = "Gerenciar Segmentos";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

<div class="card card-outline card-primary elevation-2">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title font-weight-bold"><i class="fas fa-tags text-primary mr-2"></i> Nichos de Atuação</h3>
        <button class="btn btn-primary btn-sm ml-auto" onclick="abrirModal()">
            <i class="fas fa-plus mr-1"></i> Novo Segmento
        </button>
    </div>

    <div class="card-body p-0 table-responsive">
        <table class="table table-hover table-striped mb-0" id="tbSegmentos">
            <thead class="bg-light">
                <tr>
                    <th>Nome do Segmento</th>
                    <th width="150" class="text-center">Status</th>
                    <th width="150" class="text-center">Ações</th>
                </tr>
            </thead>
            <tbody>
                <tr><td colspan="3" class="text-center py-4"><i class="fas fa-spinner fa-spin mr-2"></i> Carregando...</td></tr>
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modalSegmento" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalTitle"><i class="fas fa-tag mr-2"></i> Segmento</h5>
                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
            </div>
            <form id="formSegmento">
                <div class="modal-body bg-light">
                    <input type="hidden" id="txtId" />
                    <div class="form-group">
                        <label>Nome (Ex: Loja de Roupas, Petshop) <span class="text-danger">*</span></label>
                        <input type="text" class="form-control shadow-sm" id="txtNome" required autocomplete="off">
                    </div>
                    <div class="form-group mb-0">
                        <div class="custom-control custom-switch custom-switch-off-danger custom-switch-on-success">
                            <input type="checkbox" class="custom-control-input" id="chkAtivo" checked>
                            <label class="custom-control-label" for="chkAtivo">Segmento Ativo no Sistema</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-white">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success" id="btnSalvar"><i class="fas fa-save mr-1"></i> Salvar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/Admin/segmentos.js"></script>
}