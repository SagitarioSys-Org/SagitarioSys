@{
    ViewData["Title"] = "Painel do Administrador";
}

<div class="mb-4 mt-2">
    <h2 class="m-0 font-weight-bold" style="color: var(--zinc-900); font-size: 1.75rem; letter-spacing: -0.5px;">Visão Geral do Sistema</h2>
    <p class="text-muted m-0" style="font-size: 0.95rem;">Métricas de assinaturas, MRR e saúde do seu SaaS.</p>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="glass-card p-4" style="border-bottom: 4px solid var(--emerald-500);">
            <div class="d-flex align-items-center mb-2">
                <i class="fas fa-building text-success mr-2"></i>
                <span class="text-muted font-weight-bold" style="font-size: 0.8rem;">Empresas Ativas</span>
            </div>
            <h3 class="m-0 font-weight-bold" style="color: var(--zinc-800);">142</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="glass-card p-4" style="border-bottom: 4px solid #3b82f6;">
            <div class="d-flex align-items-center mb-2">
                <i class="fas fa-layer-group text-primary mr-2"></i>
                <span class="text-muted font-weight-bold" style="font-size: 0.8rem;">Segmentos</span>
            </div>
            <h3 class="m-0 font-weight-bold" style="color: var(--zinc-800);">3</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="glass-card p-4" style="border-bottom: 4px solid #8b5cf6;">
            <div class="d-flex align-items-center mb-2">
                <i class="fas fa-dollar-sign text-purple mr-2" style="color: #8b5cf6;"></i>
                <span class="text-muted font-weight-bold" style="font-size: 0.8rem;">MRR (Receita Mensal)</span>
            </div>
            <h3 class="m-0 font-weight-bold" style="color: var(--zinc-800);">R$ 14.500</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="glass-card p-4" style="border-bottom: 4px solid #ef4444;">
            <div class="d-flex align-items-center mb-2">
                <i class="fas fa-exclamation-triangle text-danger mr-2"></i>
                <span class="text-muted font-weight-bold" style="font-size: 0.8rem;">Inadimplentes</span>
            </div>
            <h3 class="m-0 font-weight-bold text-danger">8</h3>
        </div>
    </div>
</div>

<div class="row mb-5">
    <div class="col-md-7">
        <div class="glass-card p-4 h-100">
            <h6 class="font-weight-bold mb-4" style="color: var(--zinc-800);">Crescimento de Assinantes (Últimos 6 meses)</h6>
            <div style="height: 300px;">
                <canvas id="graficoAssinantes"></canvas>
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="glass-card p-4 h-100">
            <h6 class="font-weight-bold mb-4"><i class="fas fa-clock text-danger mr-2"></i> Atenção: Faturas Atrasadas</h6>

            <div class="table-responsive">
                <table class="table table-borderless table-hover align-middle m-0" style="font-size: 0.9rem;">
                    <thead>
                        <tr class="border-bottom text-muted" style="font-size: 0.75rem;">
                            <th>EMPRESA</th>
                            <th>VENCIMENTO</th>
                            <th class="text-right">VALOR</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="border-bottom">
                            <td class="font-weight-bold">Centro Automotivo São José</td>
                            <td class="text-danger">Há 5 dias</td>
                            <td class="text-right font-weight-bold">R$ 150,00</td>
                        </tr>
                        <tr class="border-bottom">
                            <td class="font-weight-bold">Oficina do Toninho</td>
                            <td class="text-danger">Há 12 dias</td>
                            <td class="text-right font-weight-bold">R$ 150,00</td>
                        </tr>
                        <tr>
                            <td class="font-weight-bold">Mecânica Express</td>
                            <td class="text-danger">Há 20 dias</td>
                            <td class="text-right font-weight-bold">R$ 150,00</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <button class="btn btn-block btn-outline-secondary mt-3 font-weight-bold" style="border-radius: 8px;">Ver Todos os Faturamentos</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function () {
            // Desenha o Gráfico Estático usando Chart.js
            const ctx = document.getElementById('graficoAssinantes').getContext('2d');

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['Setembro', 'Outubro', 'Novembro', 'Dezembro', 'Janeiro', 'Fevereiro'],
                    datasets: [{
                        label: 'Empresas Ativas',
                        data: [98, 105, 118, 125, 132, 142], // Dados Fictícios
                        borderColor: '#10b981', // Verde Esmeralda
                        backgroundColor: 'rgba(16, 185, 129, 0.1)',
                        borderWidth: 3,
                        pointBackgroundColor: '#fff',
                        pointBorderColor: '#10b981',
                        pointRadius: 4,
                        fill: true,
                        tension: 0.4 // Deixa a linha curvada e suave
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: {
                            beginAtZero: false,
                            grid: { borderDash: [5, 5], color: '#e4e4e7' }
                        },
                        x: { grid: { display: false } }
                    }
                }
            });
        });
    </script>
}