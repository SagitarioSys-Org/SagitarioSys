@{
    ViewData["Title"] = "Gestão de Clientes";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

<div class="d-flex justify-content-between align-items-center mb-4 mt-2">
    <div>
        <h2 class="m-0 font-weight-bold" style="color: var(--zinc-900); font-size: 1.75rem; letter-spacing: -0.5px;">Clientes</h2>
        <p class="text-muted m-0" style="font-size: 0.95rem;">Gerencie sua base de clientes e contatos.</p>
    </div>
    <button class="btn font-weight-bold px-3 py-2 shadow-sm d-flex align-items-center" style="background-color: var(--zinc-900); color: white; border-radius: 8px;" onclick="abrirModal()">
        <i class="fas fa-plus mr-2"></i> Novo Cliente
    </button>
</div>

<div class="glass-card p-0 overflow-hidden mb-4">
    <div class="p-3 border-bottom d-flex align-items-center bg-white">
        <i class="fas fa-search text-muted mr-3 pl-2"></i>
        <input type="text" id="txtBusca" class="form-control border-0 shadow-none p-0" placeholder="Buscar por nome, CPF/CNPJ ou cidade..." style="font-size: 0.95rem; background: transparent;">
    </div>

    <div class="table-responsive">
        <table class="table table-borderless table-hover align-middle m-0" id="tbClientes">
            <thead style="border-bottom: 2px solid var(--zinc-100);">
                <tr style="color: var(--zinc-400); font-size: 0.75rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px;">
                    <th class="pl-4 py-3">Nome</th>
                    <th class="py-3">CPF / CNPJ</th>
                    <th class="py-3">Cidade/UF</th>
                    <th class="py-3 text-center">Contatos Salvos</th>
                    <th class="py-3 text-center" width="100">Ações</th>
                </tr>
            </thead>
            <tbody style="color: var(--zinc-800); font-size: 0.9rem;">
                <tr><td colspan="5" class="text-center py-5"><i class="fas fa-spinner fa-spin mr-2"></i> Carregando clientes...</td></tr>
            </tbody>
        </table>
    </div>
</div>
<div class="modal fade" id="modalCliente" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalTitle"><i class="fas fa-user mr-2"></i> Ficha do Cliente</h5>
                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
            </div>
            <form id="formCliente">
                <div class="modal-body bg-light">
                    <input type="hidden" id="txtId" />

                    <h6 class="text-muted font-weight-bold mb-3 border-bottom pb-2">DADOS PRINCIPAIS</h6>
                    <div class="row">
                        <div class="col-md-8 form-group">
                            <label>Nome Completo / Razão Social <span class="text-danger">*</span></label>
                            <input type="text" class="form-control shadow-sm" id="txtNome" required>
                        </div>
                        <div class="col-md-4 form-group">
                            <label>CPF / CNPJ</label>
                            <input type="text" class="form-control shadow-sm" id="txtCpfCnpj">
                        </div>
                    </div>

                    <h6 class="text-muted font-weight-bold mt-3 mb-3 border-bottom pb-2 d-flex justify-content-between">
                        <span>MEIOS DE CONTATO</span>
                        <button type="button" class="btn btn-xs btn-outline-success" onclick="adicionarLinhaContato()">
                            <i class="fas fa-plus"></i> Adicionar Mais
                        </button>
                    </h6>
                    <div id="boxContatos"></div>

                    <h6 class="text-muted font-weight-bold mt-4 mb-3 border-bottom pb-2">ENDEREÇO (INTEGRAÇÃO VIACEP)</h6>
                    <div class="row">
                        <div class="col-md-3 form-group">
                            <label>CEP</label>
                            <div class="input-group shadow-sm">
                                <input type="text" class="form-control" id="txtCep" placeholder="00000-000">
                                <div class="input-group-append">
                                    <span class="input-group-text" id="iconeCep"><i class="fas fa-search"></i></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-7 form-group">
                            <label>Logradouro (Rua/Av)</label>
                            <input type="text" class="form-control shadow-sm" id="txtLogradouro">
                        </div>
                        <div class="col-md-2 form-group">
                            <label>Número</label>
                            <input type="text" class="form-control shadow-sm" id="txtNumero">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-5 form-group">
                            <label>Bairro</label>
                            <input type="text" class="form-control shadow-sm" id="txtBairro">
                        </div>
                        <div class="col-md-5 form-group">
                            <label>Cidade</label>
                            <input type="text" class="form-control shadow-sm" id="txtCidade">
                        </div>
                        <div class="col-md-2 form-group">
                            <label>UF</label>
                            <input type="text" class="form-control shadow-sm text-uppercase" id="txtEstado" maxlength="2">
                        </div>
                    </div>

                </div>
                <div class="modal-footer bg-white">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success" id="btnSalvar"><i class="fas fa-save mr-1"></i> Salvar Cliente</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/clientes.js"></script>
}