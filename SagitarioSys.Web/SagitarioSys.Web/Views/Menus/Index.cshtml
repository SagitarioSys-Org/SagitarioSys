@{
    ViewData["Title"] = "Gestão de Menus";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

<div class="card card-outline card-primary elevation-2">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title font-weight-bold"><i class="fas fa-list text-primary mr-2"></i> Estrutura de Menus do Sistema</h3>
        <button class="btn btn-primary btn-sm ml-auto" onclick="abrirModal()">
            <i class="fas fa-plus mr-1"></i> Adicionar Menu
        </button>
    </div>

    <div class="card-body p-0 table-responsive">
        <table class="table table-hover table-striped mb-0" id="tbMenus">
            <thead class="bg-light">
                <tr>
                    <th width="60" class="text-center">Ícone</th>
                    <th>Título</th>
                    <th>Rota da Tela</th>
                    <th>Exclusividade (VIP)</th>
                    <th width="80" class="text-center">Ordem</th>
                    <th width="120" class="text-center">Ações</th>
                </tr>
            </thead>
            <tbody>
                <tr><td colspan="7" class="text-center py-4"><i class="fas fa-spinner fa-spin mr-2"></i> Carregando...</td></tr>
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modalMenu" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalTitle"><i class="fas fa-bars mr-2"></i> Configuração de Menu</h5>
                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
            </div>
            <form id="formMenu">
                <div class="modal-body bg-light">
                    <input type="hidden" id="txtId" />

                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label>Título do Botão <span class="text-danger">*</span></label>
                            <input type="text" class="form-control shadow-sm" id="txtTitulo" placeholder="Ex: Clientes" required>
                        </div>
                        <div class="col-md-4 form-group">
                            <label>Classe do Ícone (FontAwesome) <span class="text-danger">*</span></label>
                            <div class="input-group shadow-sm">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-white"><i id="iconePreview" class="fas fa-circle text-muted"></i></span>
                                </div>
                                <input type="text" class="form-control" id="txtIcone" placeholder="fas fa-users" required>
                            </div>
                        </div>
                        <div class="col-md-2 form-group">
                            <label>Ordem <span class="text-danger">*</span></label>
                            <input type="number" class="form-control shadow-sm" id="txtOrdem" value="1" required>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 form-group">
                            <label>Rota / Link <span class="text-danger">*</span></label>
                            <input type="text" class="form-control shadow-sm" id="txtRota" placeholder="Ex: /Clientes/Index" required>
                        </div>
                    </div>

                    <h6 class="text-muted font-weight-bold mt-3 mb-3 border-bottom pb-2">REGRAS DE VISIBILIDADE</h6>
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label>Segmento Obrigatório <span class="text-danger">*</span></label>
                            <select class="form-control shadow-sm" id="ddlSegmento" required>
                                <option value="">Carregando...</option>
                            </select>
                        </div>
                        <div class="col-md-6 form-group">
                            <label>Menu Exclusivo? (Opcional)</label>
                            <select class="form-control shadow-sm border-warning" id="ddlEmpresa">
                                <option value="">Não (Aparece para todos do segmento)</option>
                            </select>
                            <small class="text-muted">Selecione uma empresa apenas se este menu for VIP/Único para ela.</small>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-white">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success" id="btnSalvar"><i class="fas fa-save mr-1"></i> Salvar Menu</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/menus.js"></script>
}