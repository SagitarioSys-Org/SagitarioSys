@{
    ViewData["Title"] = "Gestão de Veículos";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

<div class="card card-outline card-primary elevation-2">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title font-weight-bold"><i class="fas fa-car text-primary mr-2"></i> Frota de Clientes</h3>
        <button class="btn btn-primary btn-sm ml-auto" onclick="abrirModal()">
            <i class="fas fa-plus mr-1"></i> Novo Veículo
        </button>
    </div>

    <div class="card-body p-0 table-responsive">
        <table class="table table-hover table-striped mb-0" id="tbVeiculos">
            <thead class="bg-light">
                <tr>
                    <th>Placa</th>
                    <th>Veículo</th>
                    <th>Ano/Cor</th>
                    <th>Cliente (Dono)</th>
                    <th width="120" class="text-center">Ações</th>
                </tr>
            </thead>
            <tbody>
                <tr><td colspan="5" class="text-center py-4"><i class="fas fa-spinner fa-spin mr-2"></i> Carregando...</td></tr>
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modalVeiculo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalTitle"><i class="fas fa-car mr-2"></i> Ficha do Veículo</h5>
                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
            </div>
            <form id="formVeiculo">
                <div class="modal-body bg-light">
                    <input type="hidden" id="txtId" />

                    <div class="row">
                        <div class="col-md-12 form-group">
                            <label>Proprietário (Cliente) <span class="text-danger">*</span></label>
                            <select class="form-control shadow-sm" id="ddlCliente" required>
                                <option value="">Carregando clientes...</option>
                            </select>
                        </div>
                    </div>

                    <h6 class="text-muted font-weight-bold mt-2 mb-3 border-bottom pb-2">DADOS DO VEÍCULO (INTEGRAÇÃO FIPE)</h6>
                    <div class="row">
                        <div class="col-md-4 form-group">
                            <label>Marca <span class="text-danger">*</span></label>
                            <select class="form-control shadow-sm" id="ddlMarca" required>
                                <option value="">Carregando marcas...</option>
                            </select>
                            <input type="hidden" id="txtMarcaNome" />
                        </div>
                        <div class="col-md-5 form-group">
                            <label>Modelo <span class="text-danger">*</span></label>
                            <select class="form-control shadow-sm" id="ddlModelo" disabled required>
                                <option value="">Selecione a marca primeiro</option>
                            </select>
                            <input type="hidden" id="txtModeloNome" />
                        </div>
                        <div class="col-md-3 form-group">
                            <label>Ano <span class="text-danger">*</span></label>
                            <select class="form-control shadow-sm" id="ddlAno" disabled required>
                                <option value="">Selecione...</option>
                            </select>
                            <input type="hidden" id="txtAnoValor" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 form-group">
                            <label>Placa <span class="text-danger">*</span></label>
                            <input type="text" class="form-control shadow-sm text-uppercase" id="txtPlaca" placeholder="ABC-1234" maxlength="8" required>
                        </div>
                        <div class="col-md-4 form-group">
                            <label>Cor</label>
                            <input type="text" class="form-control shadow-sm" id="txtCor" placeholder="Ex: Prata">
                        </div>
                        <div class="col-md-4 form-group">
                            <label>Observações</label>
                            <input type="text" class="form-control shadow-sm" id="txtObs" placeholder="Ex: Arranhão na porta">
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-white">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success" id="btnSalvar"><i class="fas fa-save mr-1"></i> Salvar Veículo</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/veiculos.js"></script>
}