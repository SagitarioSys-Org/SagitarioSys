@{
    Layout = null; // Tira o menu do sistema! Fica só a folha branca.
}
<!DOCTYPE html>
<html>
<head>
    <title>Ordem de Serviço</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <style>
        body { font-family: Arial, sans-serif; padding: 30px; }
        .cabecalho { border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; }
        .secao { background-color: #f8f9fa; padding: 15px; border-radius: 5px; margin-bottom: 20px; border: 1px solid #dee2e6; }
        
    </style>
</head>
<body>
    <div class="text-right mb-3 btn-imprimir">
        <button class="btn btn-dark" onclick="window.print()">🖨️ Imprimir / Salvar PDF</button>
        <button class="btn btn-outline-secondary" onclick="window.close()">Fechar</button>
    </div>

    <div class="cabecalho d-flex justify-content-between">
        <div>
            <h2>SAGITARIO<b>SYS</b> - Oficina Mecânica</h2>
            <p class="mb-0">Documento Auxiliar de Ordem de Serviço</p>
        </div>
        <div class="text-right">
            <h3 id="print-os-numero">OS #0000</h3>
            <p id="print-os-data">Data: --/--/----</p>
        </div>
    </div>

    <div class="row secao">
        <div class="col-md-6">
            <h5>Dados do Cliente</h5>
            <b id="print-cliente"></b><br>
        </div>
        <div class="col-md-6 text-right">
            <h5>Dados do Veículo</h5>
            <b id="print-veiculo"></b><br>
            Placa: <span id="print-placa"></span>
        </div>
    </div>

    <div class="secao">
        <h5>Relato / Observações</h5>
        <p id="print-relato" class="mb-0"></p>
    </div>

    <table class="table table-bordered">
        <thead class="thead-light">
            <tr>
                <th>Tipo</th>
                <th>Descrição</th>
                <th class="text-center">Qtd</th>
                <th class="text-right">V. Unitário</th>
                <th class="text-right">Subtotal</th>
            </tr>
        </thead>
        <tbody id="print-itens">
            </tbody>
        <tfoot>
            <tr>
                <td colspan="4" class="text-right"><b>TOTAL GERAL:</b></td>
                <td class="text-right"><h4 class="text-success m-0 font-weight-bold" id="print-total">R$ 0,00</h4></td>
            </tr>
        </tfoot>
    </table>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function() {
            var token = localStorage.getItem("jwt_token");
            $.ajax({
                url: "https://localhost:44373/api/OrdensServico/@ViewBag.OsId",
                headers: { "Authorization": "Bearer " + token },
                success: function(os) {
                    $("#print-os-numero").text("OS #" + String(os.numeroOS).padStart(4, '0'));
                    $("#print-os-data").text("Data: " + new Date(os.dataAbertura).toLocaleDateString());
                    $("#print-cliente").text(os.nomeCliente);
                    $("#print-veiculo").text(os.modeloVeiculo);
                    $("#print-placa").text(os.placaVeiculo.toUpperCase());
                    $("#print-relato").text(os.relatoCliente || "Sem relato registrado.");
                    
                    var htmlItens = "";
                    os.itens.forEach(i => {
                        htmlItens += `<tr>
                            <td>${i.tipo}</td>
                            <td>${i.descricao}</td>
                            <td class="text-center">${i.quantidade}</td>
                            <td class="text-right">R$ ${i.valorUnitario.toFixed(2).replace('.', ',')}</td>
                            <td class="text-right">R$ ${i.valorTotal.toFixed(2).replace('.', ',')}</td>
                        </tr>`;
                    });
                    $("#print-itens").html(htmlItens);
                    $("#print-total").text("R$ " + os.valorTotal.toFixed(2).replace('.', ','));
                }
            });
        });
    </script>
</body>
</html>