@{
    var area = ViewContext.RouteData.Values["area"]?.ToString() ?? "";
    var homeLink = area switch
    {
        "Admin" => "/Admin/Home/DashboardAdmin",
        _ => $"/{area}/Dashboard/Index"
    };
}

<aside class="main-sidebar sidebar-dark-primary elevation-4">
    <a href="@homeLink" class="brand-link" style="display: flex; align-items: center; padding: 10px 15px;">
        <img src="~/img/IconSagitario.png" class="logo-icon" />
        <span class="brand-text logo-texto" style="font-family: monospace !important; font-weight: bolder;">
            Sagitario<b style="color: #28a745;">Sys</b>
        </span>
    </a>


    <div class="sidebar">
        <div class="user-panel mt-3 pb-3 mb-3 d-flex flex-column align-items-center text-center">
            <div class="info w-100">
                <img id="imgLogoSidebar"
                     alt="Logo"
                     style="max-height: 100px; object-fit: contain; display:none;">

                <a href="#" class="d-block font-weight-bold" id="lblNomeUsuario">Carregando...</a>
                <small class="text-muted" id="lblTipoEmpresa"></small>
            </div>
        </div>

        <nav class="mt-2">
            <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false" id="menuDinamico">

                <li class="nav-item">
                    <a href="@homeLink" class="nav-link active">
                        <i class="nav-icon fas fa-tachometer-alt"></i>
                        <p>Dashboard</p>
                    </a>
                </li>

                <li class="nav-header">GESTÃO</li>

            </ul>
        </nav>
    </div>
</aside>
